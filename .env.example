# Local-only placeholders. Generate unique secrets before use outside a demo.
DATABASE_URL=postgresql+psycopg://icm_app:replace-with-app-db-password@localhost:5436/icm
MIGRATION_DATABASE_URL=postgresql+psycopg://icm_owner:replace-with-owner-db-password@localhost:5436/icm
# Throwaway bootstrap-superuser password — used only by
# infra/initdb/01-create-app-role.sh to create icm_owner/icm_app, never
# used by the app or migrations (icm_owner is deliberately NOT a
# superuser — Section 12, Appendix A defect #5).
POSTGRES_BOOTSTRAP_PASSWORD=replace-with-a-throwaway-bootstrap-password
ICM_OWNER_PASSWORD=replace-with-owner-db-password
APP_DB_PASSWORD=replace-with-a-different-app-db-password
APP_SECRET_KEY=replace-with-at-least-32-random-characters
IDENTIFIER_ENCRYPTION_KEY=generate-a-fernet-key
IDENTIFIER_FINGERPRINT_KEY=replace-with-a-different-random-secret-of-32-or-more-characters
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
STEP_UP_TTL_MINUTES=5
LOCKOUT_THRESHOLD=5
LOCKOUT_WINDOW_MINUTES=10
WEB_ORIGIN=http://localhost:3001
VALKEY_URL=redis://localhost:6379/0
COOKIES_SECURE=false
